{
  "rules": {
    "leaderboard": {
      ".read": "auth != null",
      "$entry": {
        ".write": "auth != null && ($entry.beginsWith(auth.uid) || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "weeklyHistory": {
      ".read": "auth != null",
      "$weekNum": {
        "$entry": {
          ".write": "auth != null && ($entry.beginsWith(auth.uid) || root.child('admins').child(auth.uid).val() === true)"
        }
      }
    },
    "weeklyWinners": {
      ".read": "auth != null",
      "$weekNum": {
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },
    "v2": {
      "tracks": {
        "$trackId": {
          "leaderboard": {
            ".read": "auth != null",
            "$key": {
              ".write": "auth != null && ($key.beginsWith(auth.uid + '_') || root.child('admins').child(auth.uid).val() === true)",
              ".validate": "newData.hasChildren(['uid','profileId','trackId','name','points'])",
              "uid": {
                ".validate": "newData.val() === auth.uid"
              },
              "trackId": {
                ".validate": "newData.val() === $trackId"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "profileId": {
                ".validate": true
              },
              "leaderboardKey": {
                ".validate": true
              },
              "avatar": {
                ".validate": true
              },
              "theme": {
                ".validate": true
              },
              "points": {
                ".validate": "newData.isNumber()"
              },
              "weeklyPoints": {
                ".validate": "newData.isNumber()"
              },
              "weekStartKey": {
                ".validate": true
              },
              "rank": {
                ".validate": true
              },
              "rankPiece": {
                ".validate": true
              },
              "stats": {
                ".validate": true
              },
              "currentStreak": {
                ".validate": "newData.isNumber()"
              },
              "lastSeen": {
                ".validate": true
              },
              "ownerEmail": {
                ".validate": false
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "weeklyHistory": {
            ".read": "auth != null",
            "$week": {
              "$key": {
                ".write": "auth != null && ($key.beginsWith(auth.uid + '_') || root.child('admins').child(auth.uid).val() === true)"
              }
            }
          },
          "weeklyWinners": {
            ".read": "auth != null",
            "$week": {
              ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)"
            }
          }
        }
      },
      "groups": {
        "$groupId": {
          ".read": "auth != null",
          "meta": {
            ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name','trackId','ownerUid','ownerName','createdAt','open'])",
            "ownerUid": {
              ".validate": "newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "ownerName": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "trackId": {
              ".validate": "newData.isString()"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "open": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "members": {
            "$key": {
              ".write": "auth != null && ($key.beginsWith(auth.uid + '_') || root.child('v2').child('groups').child($groupId).child('meta').child('ownerUid').val() === auth.uid)",
              ".validate": "!newData.exists() || newData.hasChildren(['name','avatar','joinedAt'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "avatar": {
                ".validate": "newData.isString() && newData.val().length <= 8"
              },
              "joinedAt": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "families": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
