{
  "_comment": "MERGED RULES — v1 (SummerStreak, live) + v2 (Beat the Slide). Both apps share the summerstreak project. The v1 block below is UNCHANGED from what is published today: do not edit it. v2 lives entirely under /v2.",

  "rules": {

    "leaderboard": {
      ".read": "auth != null",
      "$entry": {
        ".write": "auth != null && ($entry.beginsWith(auth.uid) || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "weeklyHistory": {
      ".read": "auth != null",
      "$weekNum": {
        "$entry": {
          ".write": "auth != null && ($entry.beginsWith(auth.uid) || root.child('admins').child(auth.uid).val() === true)"
        }
      }
    },
    "weeklyWinners": {
      ".read": "auth != null",
      "$weekNum": {
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },

    "v2": {
      "tracks": {
        "$trackId": {
          "leaderboard": {
            ".read": "auth != null",
            "$key": {
              ".write": "auth != null && ($key.beginsWith(auth.uid + '_') || root.child('admins').child(auth.uid).val() === true)",
              ".validate": "newData.hasChildren(['uid','profileId','trackId','name','points'])",
              "uid":     { ".validate": "newData.val() === auth.uid" },
              "trackId": { ".validate": "newData.val() === $trackId" },
              "name":    { ".validate": "newData.isString() && newData.val().length <= 24" },
              "profileId":      { ".validate": true },
              "leaderboardKey": { ".validate": true },
              "avatar":         { ".validate": true },
              "theme":          { ".validate": true },
              "points":         { ".validate": "newData.isNumber()" },
              "weeklyPoints":   { ".validate": "newData.isNumber()" },
              "weekStartKey":   { ".validate": true },
              "rank":           { ".validate": true },
              "rankPiece":      { ".validate": true },
              "stats":          { ".validate": true },
              "currentStreak":  { ".validate": "newData.isNumber()" },
              "lastSeen":       { ".validate": true },
              "ownerEmail":     { ".validate": false },
              "$other":         { ".validate": false }
            }
          },
          "weeklyHistory": {
            ".read": "auth != null",
            "$week": {
              "$key": {
                ".write": "auth != null && ($key.beginsWith(auth.uid + '_') || root.child('admins').child(auth.uid).val() === true)"
              }
            }
          },
          "weeklyWinners": {
            ".read": "auth != null",
            "$week": {
              ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)"
            }
          }
        }
      },
      "groups": {
        "$groupId": {
          ".read": "auth != null",
          "meta": {
            ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name','trackId','ownerUid','ownerName','createdAt','open'])",
            "ownerUid":  { ".validate": "newData.val() === auth.uid" },
            "name":      { ".validate": "newData.isString() && newData.val().length <= 40" },
            "ownerName": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "trackId":   { ".validate": "newData.isString()" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "open":      { ".validate": "newData.isBoolean()" },
            "startDate":   { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
            "lengthWeeks": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 52" },
            "mode":        { ".validate": "newData.val() === 'kids' || newData.val() === 'teams'" },
            "$other":    { ".validate": false }
          },
          "members": {
            "$key": {
              ".write": "auth != null && ($key.beginsWith(auth.uid + '_') || (!newData.exists() && (root.child('v2').child('groups').child($groupId).child('meta').child('ownerUid').val() === auth.uid || (data.child('team').isString() && root.child('v2').child('groups').child($groupId).child('teams').child(data.child('team').val()).child('ownerUid').val() === auth.uid))))",
              ".validate": "!newData.exists() || (newData.hasChildren(['name','avatar','joinedAt']) && (root.child('v2').child('groups').child($groupId).child('meta').child('mode').val() !== 'teams' || newData.hasChild('team')))",
              "name":     { ".validate": "newData.isString() && newData.val().length <= 24" },
              "avatar":   { ".validate": "newData.isString() && newData.val().length <= 8" },
              "joinedAt": { ".validate": "newData.isNumber()" },
              "points":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "team":     { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val()) && root.child('v2').child('groups').child($groupId).child('teams').child(newData.val()).exists()" },
              "$other":   { ".validate": false }
            }
          },
          "teams": {
            "$teamId": {
              ".write": "auth != null && (data.exists() ? (data.child('ownerUid').val() === auth.uid || (!newData.exists() && root.child('v2').child('groups').child($groupId).child('meta').child('ownerUid').val() === auth.uid)) : (newData.parent().parent().child('meta').child('mode').val() === 'teams' && newData.parent().parent().child('meta').child('open').val() === true))",
              ".validate": "newData.hasChildren(['name','ownerUid','ownerName','createdAt'])",
              "name":      { ".validate": "newData.isString() && newData.val().length <= 40" },
              "ownerUid":  { ".validate": "newData.val() === auth.uid" },
              "ownerName": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "createdAt": { ".validate": "newData.isNumber()" },
              "$other":    { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      },
      "families": {
        "$uid": {
          ".read":  "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
