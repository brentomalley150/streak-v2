# Firebase — copy to .env.local and fill in from the Firebase console.
# Web API keys are public by design (they identify the project, they don't
# authorise anything). Security comes from Realtime Database rules + Auth.
# https://firebase.google.com/docs/projects/api-keys
#
# Leave these unset and the app runs fully offline against localStorage.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_DATABASE_URL=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=
